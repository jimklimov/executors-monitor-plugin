<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define" xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:s="/lib/form">
  <j:choose>
    <j:when test="${data==null}">
      <td align="right" data="-1">N/A</td>
    </j:when>
    <j:otherwise>
      <j:set var="queueThresholdFactor" value="${(from.queueThresholdFactor == null or from.queueThresholdFactor le 1) ? 5 : from.queueThresholdFactor}"/>
      <td align="right" data="${data.busy}">
        <span style="${from.colorize ? (data.busy gt data.configured ? 'color:var(--red)' : (data.busy == 0 ? 'color:var(--blue)' : (data.busy lt data.total ? 'color:var(--green)' : ''))) : ''}">${data.busy}/${data.total}/${data.configured}</span>
        <j:if test="${data.queued != null}">
          <span style="${from.colorize ? (data.queued == 0 ? 'color:var(--blue)' : (data.queued le data.configured ? 'color:var(--green)' : (data.queued gt (data.configured * queueThresholdFactor) ? 'color:var(--red)' : ''))) : ''}">&#160;q:${data.queued}</span>
        </j:if>
      </td>
    </j:otherwise>
  </j:choose>
</j:jelly>
