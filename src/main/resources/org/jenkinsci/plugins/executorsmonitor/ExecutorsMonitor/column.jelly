<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define" xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:s="/lib/form">
  <j:choose>
    <j:when test="${data==null}">
      <td align="right" data="-1">N/A</td>
    </j:when>
    <j:otherwise>
      <td align="right" data="${data.busy}"
          style="${from.colorize ? (data.busy gt data.configured ? 'color:var(--red)' : (data.busy == 0 ? 'color:var(--blue)' : (data.busy lt data.total ? 'color:var(--green)' : ''))) : ''}">${data}</td>
    </j:otherwise>
  </j:choose>
</j:jelly>
